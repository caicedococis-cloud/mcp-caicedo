# Copia este archivo como .env y rellena lo que tengas.
# Nunca pongas aquí la clave privada de una billetera: el bot no la necesita.
# La estrategia (tamaños, stop loss, filtros...) se configura desde el dashboard.

# Helius (https://dashboard.helius.dev): historial de swaps de cada billetera.
# Sin esta clave el bot arranca en modo demo con datos simulados.
HELIUS_API_KEY=

# Birdeye (https://bds.birdeye.so), opcional: propone candidatas entre los traders
# con más ganancia de la semana o del mes.
BIRDEYE_API_KEY=

# Jupiter (https://developers.jup.ag/portal), opcional: sin clave usa el plan gratuito.
JUPITER_API_KEY=

# Anthropic (https://console.anthropic.com): análisis con IA de cada entrada y salida.
# Sin clave se usa un análisis por reglas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low es rápido y barato para analizar muchas operaciones; sube a medium o high si quieres más profundidad.
ANTHROPIC_EFFORT=low

# Lista de billeteras que quieres evaluar siempre (se edita desde el dashboard o el servidor MCP).
WATCHLIST_PATH=data/watchlist.json

# Fuerza el modo demo aunque tengas clave de Helius.
DEMO=false

# Dashboard local (solo accesible desde tu equipo).
PORT=4747
OPEN_BROWSER=true
